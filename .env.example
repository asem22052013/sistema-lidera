# Токен от @BotFather
BOT_TOKEN=

# Telegram ID админов через запятую (узнать свой ID: @userinfobot). Админам доступны /stats, /grant, /revoke
ADMIN_IDS=

DB_PATH=data/bot.sqlite3

# Время: Казахстан — UTC+5. Пользователь может сменить свой пояс через /tz
DEFAULT_TZ_OFFSET=5
TASK_HOUR=9
REMINDER_HOUR=20
CONTACTS_HOUR=10
RATING_HOUR=10
INACTIVE_DAYS=3
MAX_MENTEES=5

# Пилот: true — программа бесплатна для всех.
# false — полный доступ у новичков с наставником и у тех, кому админ выдал /grant; остальные проходят только день 1
FREE_ACCESS=true

# Ссылки
PRO_URL=
PRIVACY_URL=
CHANNEL_URL=
